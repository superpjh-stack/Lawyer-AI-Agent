# LexAgent - 환경변수 예시
# 이 파일을 복사하여 .env.local 로 저장하고 실제 값을 입력하세요.
# .env.local 파일은 절대 git에 커밋하지 마세요.

# ============================================================
# OpenAI
# ============================================================
OPENAI_API_KEY=sk-proj-...

# ============================================================
# 데이터베이스 (Supabase PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ============================================================
# Supabase (파일 저장, 인증)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# NextAuth.js (인증)
# ============================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-minimum-32-characters

# ============================================================
# Redis (Upstash - 캐시 및 Rate Limiting)
# ============================================================
UPSTASH_REDIS_REST_URL=https://[id].upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ============================================================
# 이메일 발송 (Resend)
# ============================================================
RESEND_API_KEY=re_...
EMAIL_FROM=no-reply@lexagent.kr

# ============================================================
# 외부 법률 DB API
# ============================================================
# 국가법령정보센터 Open API (https://www.law.go.kr/LSO/openapi/openApiInfo.do)
KOREA_LAW_API_KEY=your-key-here

# 대법원 종합법률정보 API (https://www.law.go.kr/LSO/openapi/openApiInfo.do)
SUPREME_COURT_API_KEY=your-key-here

# ============================================================
# 앱 설정
# ============================================================
NEXT_PUBLIC_APP_NAME=LexAgent
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
