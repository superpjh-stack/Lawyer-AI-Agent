# =====================================================================
#  PLC Data Gateway - 환경변수 예시
#  이 파일을 복사해 plc-gateway/.env 로 저장하고 값을 수정하세요.
#  모든 항목은 생략 가능하며, 생략 시 아래 기본값이 적용됩니다.
# =====================================================================

# ---------------------------------------------------------------------
#  일반
# ---------------------------------------------------------------------
NODE_ENV=development
# 로그 레벨: debug | info | warn | error  (debug 는 매 초 샘플을 출력하므로 운영에서는 info 권장)
LOG_LEVEL=info

# ---------------------------------------------------------------------
#  PLC 연결
# ---------------------------------------------------------------------
# simulator : 가상 PLC (실제 장비 없이 개발/시연)
# modbus-tcp: Modbus TCP 로 실제 PLC 접속
PLC_DRIVER=simulator
PLC_HOST=192.168.0.10
PLC_PORT=502
# Modbus Unit ID (Slave ID). 대부분 1
PLC_UNIT_ID=1
# holding (FC03, 4xxxx) | input (FC04, 3xxxx)
PLC_REGISTER_TYPE=holding
# 레지스터를 부호 있는 16bit 로 해석 (영하 온도 등 음수 필요 시 true)
PLC_REGISTER_SIGNED=true

# ---------------------------------------------------------------------
#  태그 매핑: 값 = raw * SCALE + OFFSET
#  예) 온도 레지스터 원시값 253, SCALE 0.1 → 25.3 ℃
# ---------------------------------------------------------------------
PLC_TEMP_REGISTER=0
PLC_TEMP_SCALE=0.1
PLC_TEMP_OFFSET=0

PLC_PRESSURE_REGISTER=1
PLC_PRESSURE_SCALE=0.01
PLC_PRESSURE_OFFSET=0

# ---------------------------------------------------------------------
#  폴링 (1초에 1회)
# ---------------------------------------------------------------------
POLL_INTERVAL_MS=1000
# 1회 읽기 타임아웃. 반드시 POLL_INTERVAL_MS 보다 작아야 함
POLL_TIMEOUT_MS=800
# 재접속 백오프: 1s → 2s → 4s ... → 최대 30s
RECONNECT_BASE_MS=1000
RECONNECT_MAX_MS=30000

# ---------------------------------------------------------------------
#  인메모리 저장소
# ---------------------------------------------------------------------
# 보관 샘플 수. 3600 = 1시간 (1초 주기 기준)
HISTORY_CAPACITY=3600
ALARM_HISTORY_CAPACITY=500

# ---------------------------------------------------------------------
#  알람 임계값 (빈 값("")으로 두면 해당 임계값 비활성화)
# ---------------------------------------------------------------------
ALARM_TEMP_HIGH=80
ALARM_TEMP_LOW=-10
ALARM_TEMP_HYSTERESIS=2
ALARM_PRESSURE_HIGH=8
ALARM_PRESSURE_LOW=0.5
ALARM_PRESSURE_HYSTERESIS=0.2

# ---------------------------------------------------------------------
#  HTTP / WebSocket 서버
# ---------------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=4000
# 설정 시 /api/* 와 /ws 에 X-API-Key 헤더(또는 ?apiKey=) 필요. /health, /metrics 는 항상 공개
GATEWAY_API_KEY=
CORS_ORIGIN=*

# ---------------------------------------------------------------------
#  싱크 1: JSONL 파일 (data/plc-YYYY-MM-DD.jsonl)
# ---------------------------------------------------------------------
SINK_JSONL_ENABLED=false
SINK_JSONL_DIR=./data
SINK_JSONL_FLUSH_MS=2000

# ---------------------------------------------------------------------
#  싱크 2: 상위 서버로 HTTP 배치 전송 (URL 설정 시 활성화)
#  POST { "source": "plc-gateway", "samples": [...] }
# ---------------------------------------------------------------------
SINK_HTTP_URL=
SINK_HTTP_TOKEN=
SINK_HTTP_BATCH_SIZE=10
SINK_HTTP_FLUSH_MS=5000
SINK_HTTP_MAX_BUFFER=1000

# ---------------------------------------------------------------------
#  시뮬레이터 (PLC_DRIVER=simulator 일 때만 사용)
# ---------------------------------------------------------------------
# 읽기 실패 확률 (0~1). 재접속 로직 테스트용. 예) 0.1 = 10%
SIM_FAULT_RATE=0
SIM_TEMP_BASE=25
SIM_PRESSURE_BASE=3
