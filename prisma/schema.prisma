generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Firm {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("personal")
  maxUsers  Int      @default(1)
  createdAt DateTime @default(now())
  users     User[]
  clients   Client[]
}

model User {
  id             String    @id @default(cuid())
  firmId         String
  name           String
  email          String    @unique
  passwordHash   String
  role           String    @default("member")
  createdAt      DateTime  @default(now())
  firm           Firm      @relation(fields: [firmId], references: [id])
  assignedCases  Case[]    @relation("AssignedUser")
  conversations  Conversation[]
  documents      Document[]     @relation("UploadedBy")
  billingEntries BillingEntry[]
  researchResults ResearchSavedResult[]
  advisories      Advisory[]
  caseLawBookmarks CaseLawBookmark[]
  knowledgeEntries  LawKnowledge[]     @relation("LawyerKnowledge")
  agentExecutions   AgentExecution[]
  @@index([firmId])
  @@index([email])
}

model Client {
  id        String   @id @default(cuid())
  firmId    String
  name      String
  email     String?
  phone     String?
  type      String   @default("individual")
  createdAt DateTime @default(now())
  firm      Firm     @relation(fields: [firmId], references: [id])
  cases     Case[]
  invoices  Invoice[]
  @@index([firmId])
}

model Case {
  id             String   @id @default(cuid())
  caseNumber     String   @unique
  title          String
  description    String?
  clientId       String
  assignedUserId String
  status         String   @default("active")
  category       String
  courtName      String?
  caseYear       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  client         Client   @relation(fields: [clientId], references: [id])
  assignedUser   User     @relation("AssignedUser", fields: [assignedUserId], references: [id])
  documents      Document[]
  deadlines      Deadline[]
  billingEntries BillingEntry[]
  researchResults ResearchSavedResult[]
  caseLawBookmarks CaseLawBookmark[]
  @@index([clientId])
  @@index([assignedUserId])
  @@index([status])
}

model Document {
  id         String   @id @default(cuid())
  caseId     String?
  uploadedBy String
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  docType    String
  aiSummary  String?
  riskLevel  String?
  embeddingStatus String?
  createdAt  DateTime @default(now())
  case       Case?    @relation(fields: [caseId], references: [id])
  uploader   User     @relation("UploadedBy", fields: [uploadedBy], references: [id])
  knowledgeChunks LawKnowledge[] @relation("KnowledgeSource")
  @@index([caseId])
  @@index([uploadedBy])
}

model Deadline {
  id           String   @id @default(cuid())
  caseId       String
  title        String
  dueDate      DateTime
  deadlineType String
  status       String   @default("pending")
  reminderSent Boolean  @default(false)
  createdAt    DateTime @default(now())
  case         Case     @relation(fields: [caseId], references: [id])
  @@index([caseId])
  @@index([dueDate])
  @@index([status])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  toolUseData    String?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId])
}

model ResearchSavedResult {
  id         String   @id @default(cuid())
  userId     String
  caseId     String?
  query      String
  resultData String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  case       Case?    @relation(fields: [caseId], references: [id])
  @@index([userId])
  @@index([caseId])
}

model Advisory {
  id          String   @id @default(cuid())
  userId      String
  title       String
  type        String   // case_advisory | supreme_court | institution | other
  background  String
  purpose     String
  status      String   @default("draft") // draft | v1 | v2 | v3
  draft1      String?  // 1차 초안
  draft2      String?  // 2차 상세
  draft3      String?  // 3차 최종
  toc1        Json?    // 1차 목차
  toc2        Json?    // 2차 목차
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([status])
}

model BillingEntry {
  id          String   @id @default(cuid())
  caseId      String
  userId      String
  description String
  hours       Float
  hourlyRate  Float
  amount      Float
  date        DateTime
  invoiceId   String?
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  @@index([caseId])
  @@index([invoiceId])
}

model Invoice {
  id          String    @id @default(cuid())
  clientId    String
  totalAmount Float
  status      String    @default("draft")
  issuedAt    DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  client      Client    @relation(fields: [clientId], references: [id])
  entries     BillingEntry[]
  @@index([clientId])
}

model CaseLawBookmark {
  id              String   @id @default(cuid())
  userId          String
  caseId          String?
  serialNumber    String
  caseNumber      String
  caseName        String
  courtName       String
  judgmentDate     String
  caseType        String?
  aiSummary       String?
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
  case            Case?    @relation(fields: [caseId], references: [id])
  @@unique([userId, serialNumber])
  @@index([userId])
  @@index([caseId])
}

model LawKnowledge {
  id             String   @id @default(cuid())
  lawyerId       String?
  sourceDocId    String?
  title          String
  content        String
  chunkIndex     Int      @default(0)
  totalChunks    Int      @default(1)
  docType        String
  practiceArea   String
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lawyer         User?     @relation("LawyerKnowledge", fields: [lawyerId], references: [id])
  sourceDocument Document? @relation("KnowledgeSource", fields: [sourceDocId], references: [id])
  @@index([lawyerId])
  @@index([docType])
  @@index([practiceArea])
  @@index([lawyerId, docType])
  @@index([lawyerId, practiceArea])
}

model AgentExecution {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  taskType       String
  input          String
  steps          Json
  finalOutput    String?
  status         String   @default("running")
  totalDuration  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([status])
  @@index([taskType])
}
